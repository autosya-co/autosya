---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import { db } from '../lib/firebase';
import { doc, getDoc } from 'firebase/firestore';

interface Props {
	title: string;
	description?: string;
	image?: string;
	url?: string;
	type?: string;
}

const { title, description, image, url, type } = Astro.props;

let config: any = {};
try {
	const configSnap = await getDoc(doc(db, "configuracion", "autosya"));
	if (configSnap.exists()) {
		config = configSnap.data();
	}
} catch (e) {
	console.error("Error cargando configuración en Layout:", e);
}

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || config.google_client_id || '308604847797-3cus32hvup377vnnqfe8sdeuhhdd8192.apps.googleusercontent.com';
const googleSiteVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || config.google_site_verification || '';

const siteUrl = "https://autosya.co";
const currentPath = Astro.url.pathname;
const canonicalUrl = url || (currentPath === '/' ? siteUrl : `${siteUrl}${currentPath}`);
const pageType = type || "website";

// Helper para convertir cualquier imagen o Drive ID en URL directa 200 para WhatsApp / OpenGraph
function resolveOgImage(img?: string): string {
	if (!img) return `${siteUrl}/logo-autosya.png`;
	const thumbMatch = img.match(/thumbnail\?id=([a-zA-Z0-9_-]+)/);
	if (thumbMatch) {
		return `https://lh3.googleusercontent.com/d/${thumbMatch[1]}=w1200`;
	}
	const dMatch = img.match(/\/d\/([a-zA-Z0-9_-]+)/);
	if (dMatch) {
		const cleanId = dMatch[1].split('=')[0];
		return `https://lh3.googleusercontent.com/d/${cleanId}=w1200`;
	}
	if (/^[a-zA-Z0-9_-]{20,}$/.test(img)) {
		return `https://lh3.googleusercontent.com/d/${img}=w1200`;
	}
	if (img.startsWith('/')) {
		return `${siteUrl}${img}`;
	}
	return img;
}

const metaDescription = description || config.eslogan || "Tu portal de compra y venta de autos usados en Colombia. Encuentra tu vehículo ideal en AutosYa.";
const rawImage = image || config.logo || "/logo-autosya.png";
const ogImageUrl = resolveOgImage(rawImage);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={metaDescription} />
		<meta name="theme-color" content="#dc2626" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />
		<meta name="apple-mobile-web-app-title" content="AutosYa" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalUrl} />

		<!-- Google Search Console Verification -->
		{googleSiteVerification && (
			<meta name="google-site-verification" content={googleSiteVerification} />
		)}

		<!-- OpenGraph / Facebook / WhatsApp -->
		<meta property="og:site_name" content="AutosYa" />
		<meta property="og:type" content={pageType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={metaDescription} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:secure_url" content={ogImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={metaDescription} />
		<meta name="twitter:image" content={ogImageUrl} />

		<slot name="head" />

		<!-- Schema.org Structured Data -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "AutoDealer",
			"name": "AutosYa",
			"url": "https://autosya.co",
			"logo": `${siteUrl}/logo-autosya.png`,
			"image": ogImageUrl,
			"description": metaDescription,
			"telephone": config.telefono || "+573202832616",
			"address": {
				"@type": "PostalAddress",
				"streetAddress": config.direccion || "Calle 11A # 1E - 29 Caobos",
				"addressLocality": "Cúcuta",
				"addressCountry": "CO"
			}
		})} />
		<!-- Imports for plugins previously loaded via CDN (Lucide, PapaParse, Sortable) -->
		<!-- We load them from CDN as inline to keep the original logic untouched first, or use the node modules -->
		<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
		<script is:inline src="https://unpkg.com/lucide@latest"></script>
		<script is:inline src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>

		<meta id="cfgGoogleClientId" name="google-client-id" content={googleClientId} />
		<!-- Google Identity Services -->
		<script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
		<script is:inline>
			// Global auth configuration
			window.ADMIN_EMAILS = ['autosya.co@gmail.com', 'autosyacucuta@gmail.com', 'jjpr79@gmail.com'];
			window.GOOGLE_CLIENT_ID = document.getElementById('cfgGoogleClientId')?.getAttribute('content') || '308604847797-3cus32hvup377vnnqfe8sdeuhhdd8192.apps.googleusercontent.com';

			// Check auth state immediately to prevent flicker
			if (typeof localStorage !== 'undefined') {
				if (localStorage.getItem('isLoggedIn') === 'true') {
					document.documentElement.classList.add('is-logged-in');
				}
				if (localStorage.getItem('isAdmin') === 'true') {
					document.documentElement.classList.add('is-admin');
				}
			}

			async function handleCredentialResponse(response) {
				try {
					const token = response.credential;
					const base64Url = token.split('.')[1];
					const base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');
					const jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {
						return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
					}).join(''));
					
					const payload = JSON.parse(jsonPayload);
					const emailLimpio = (payload.email || '').toLowerCase().trim();
					
					// Guardamos sesión general en localStorage
					localStorage.setItem('isLoggedIn', 'true');
					localStorage.setItem('userEmail', emailLimpio);
					localStorage.setItem('userName', payload.name || emailLimpio.split('@')[0]);
					if (payload.picture) localStorage.setItem('userPicture', payload.picture);
					document.documentElement.classList.add('is-logged-in');

					// Validamos si es admin
					if (window.ADMIN_EMAILS && window.ADMIN_EMAILS.includes(emailLimpio)) {
						localStorage.setItem('isAdmin', 'true');
						document.documentElement.classList.add('is-admin');
					} else {
						localStorage.removeItem('isAdmin');
					}

					// Sincronizar credencial con Firebase Auth en segundo plano
					if (window.auth && window.GoogleAuthProvider && window.signInWithCredential) {
						try {
							const cred = window.GoogleAuthProvider.credential(token);
							await window.signInWithCredential(window.auth, cred);
						} catch (authErr) {
							console.warn("Aviso sincronización Firebase Auth:", authErr);
						}
					}

					// Persistimos en Firestore en segundo plano (sin bloquear la recarga)
					if (window.saveUserToFirestore) {
						window.saveUserToFirestore({
							email: emailLimpio,
							name: payload.name || emailLimpio.split('@')[0],
							picture: payload.picture || null
						}).catch(console.warn);
					}

					// Recarga inmediata para mostrar la sesión activa
					window.location.reload();
				} catch(e) {
					console.error("Error procesando One Tap:", e);
					window.location.reload();
				}
			}

			window.loginWithEmail = async function(email, name) {
				try {
					const trimmedEmail = (email || '').toLowerCase().trim();
					if (!trimmedEmail) return;
					localStorage.setItem('isLoggedIn', 'true');
					localStorage.setItem('userEmail', trimmedEmail);
					localStorage.setItem('userName', name || trimmedEmail.split('@')[0]);
					document.documentElement.classList.add('is-logged-in');

					if (window.ADMIN_EMAILS && window.ADMIN_EMAILS.includes(trimmedEmail)) {
						localStorage.setItem('isAdmin', 'true');
						document.documentElement.classList.add('is-admin');
					} else {
						localStorage.removeItem('isAdmin');
					}

					if (window.saveUserToFirestore) {
						await window.saveUserToFirestore({
							email: trimmedEmail,
							name: name || trimmedEmail.split('@')[0],
							picture: null
						}).catch(console.warn);
					}
					window.location.reload();
				} catch(err) {
					console.error("Error al iniciar sesión:", err);
				}
			};

			window.initGoogleAuth = function() {
				if (window.google && window.google.accounts && window.google.accounts.id) {
					try {
						window.google.accounts.id.initialize({
							client_id: window.GOOGLE_CLIENT_ID,
							callback: handleCredentialResponse,
							auto_select: false,
							use_fedcm_for_prompt: true
						});

						// Solo intentamos One Tap automático fuera de iframes si no hay sesión activa
						const isInIframe = window.self !== window.top;
						if (!isInIframe && localStorage.getItem('isLoggedIn') !== 'true') {
							window.google.accounts.id.prompt((notification) => {
								if (notification && notification.isNotDisplayed && notification.isNotDisplayed()) {
									console.info("Google One Tap no disponible:", notification.getNotDisplayedReason());
								}
							});
						}

						// Notificar que Google Auth está listo para renderizar botones si es necesario
						window.dispatchEvent(new CustomEvent('google-auth-ready'));
					} catch(e) {
						console.warn("Aviso al inicializar Google Auth:", e);
					}
				}
			};


			window.addEventListener('load', function() {
				const checkGoogle = setInterval(() => {
					if (window.google && window.google.accounts) {
						clearInterval(checkGoogle);
						window.initGoogleAuth();
					}
				}, 100);
			});
		</script>

		<script>
			import { db, auth } from '../lib/firebase';
			import { doc, setDoc, serverTimestamp } from 'firebase/firestore';
			import { GoogleAuthProvider, signInWithPopup, signInWithCredential } from 'firebase/auth';

			// Exponer al objeto window para interoperabilidad
			window.auth = auth;
			window.GoogleAuthProvider = GoogleAuthProvider;
			window.signInWithCredential = signInWithCredential;

			// Exponemos la función al objeto window para que el script inline de Auth pueda llamarla
			window.saveUserToFirestore = async (payload) => {
				try {
					const userRef = doc(db, 'usuarios', payload.email.toLowerCase().trim());
					await setDoc(userRef, {
						nombre: payload.name || payload.email.split('@')[0],
						email: payload.email.toLowerCase().trim(),
						foto: payload.picture || null,
						ultimoAcceso: serverTimestamp()
					}, { merge: true });
				} catch (e) {
					console.error("Error guardando usuario en Firestore:", e);
				}
			};

			// Inicio de sesión directo y nativo con Firebase Auth Google Popup
			window.loginWithGoogleFirebase = async () => {
				try {
					const provider = new GoogleAuthProvider();
					provider.setCustomParameters({ prompt: 'select_account' });
					const result = await signInWithPopup(auth, provider);
					const user = result.user;
					const emailLimpio = (user.email || '').trim().toLowerCase();

					localStorage.setItem('isLoggedIn', 'true');
					localStorage.setItem('userEmail', emailLimpio);
					localStorage.setItem('userName', user.displayName || emailLimpio.split('@')[0]);
					if (user.photoURL) localStorage.setItem('userPicture', user.photoURL);

					const ADMIN_EMAILS = ['autosya.co@gmail.com', 'autosyacucuta@gmail.com', 'jjpr79@gmail.com'];
					if (ADMIN_EMAILS.includes(emailLimpio)) {
						localStorage.setItem('isAdmin', 'true');
						document.documentElement.classList.add('is-admin');
					}
					document.documentElement.classList.add('is-logged-in');

					if (window.saveUserToFirestore) {
						await window.saveUserToFirestore({
							name: user.displayName,
							email: emailLimpio,
							picture: user.photoURL
						});
					}

					window.location.reload();
				} catch (error) {
					console.error("Error en login con Google Firebase:", error);
					if (error.code === 'auth/unauthorized-domain') {
						alert("⚠️ Dominio no autorizado en Firebase:\n\nDebes agregar 'autosya.co' y 'www.autosya.co' en:\nConsola de Firebase > Authentication > Settings (Configuración) > Dominios autorizados.");
					} else if (error.code === 'auth/configuration-not-found' || error.code === 'auth/operation-not-allowed') {
						alert("⚠️ El proveedor de Google no está habilitado en Firebase Authentication.\nHabilítalo en:\nConsola de Firebase > Authentication > Sign-in method > Google.");
					} else if (error.code !== 'auth/popup-closed-by-user') {
						alert("Error al iniciar sesión: " + (error.message || error.code));
					}
				}
			};
		</script>
		<style is:inline>
			/* Clases utilitarias para elementos de administrador */
			.admin-only, .admin-only-flex, .admin-only-block, .admin-only-inline { display: none !important; }
			html.is-admin .admin-only { display: inherit !important; }
			html.is-admin .admin-only-block { display: block !important; }
			html.is-admin .admin-only-flex { display: flex !important; }
			html.is-admin .admin-only-inline { display: inline-block !important; }

			/* Clases para cualquier usuario logueado */
			.logged-only, .logged-only-flex, .logged-only-block { display: none !important; }
			html.is-logged-in .logged-only { display: inherit !important; }
			html.is-logged-in .logged-only-block { display: block !important; }
			html.is-logged-in .logged-only-flex { display: flex !important; }
			
			/* Ocultar elementos si el usuario está logueado (ej: botón de login manual) */
			html.is-logged-in .guest-only,
			html.is-logged-in .guest-only-flex,
			html.is-logged-in .guest-only-block { display: none !important; }
		</style>
		<slot name="head" />
	</head>
	<body class="bg-gray-50 min-h-screen font-sans text-gray-800">
		<slot />
		<Footer />
		<script is:inline>
			lucide.createIcons();
			// Registrar Service Worker para PWA
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js').catch(() => {});
				});
			}
		</script>
	</body>
</html>
